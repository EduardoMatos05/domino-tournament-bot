# Opcional. Copia este archivo a .env para cambiar valores por defecto.
# Las cuentas y la URL del torneo se capturan en la interfaz, NO aquí.

# Puerto de la interfaz local (http://127.0.0.1:PUERTO)
BOT_UI_PORT=4173

# 1 = navegadores sin ventana (no recomendado para el MVP), 0 = visibles
BOT_HEADLESS=0

# 1 = no abrir el navegador automáticamente con la interfaz
BOT_NO_OPEN=0
